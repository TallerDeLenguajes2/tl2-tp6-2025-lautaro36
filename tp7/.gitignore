#
# General
#

## Files and folders that are often generated by build processes, IDEs, or package managers.
## Controllers, Models, and Repositories are typically source code and should be committed,
## but the files ignored here are generated files related to them.

# VS Code files
.vscode/

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
*.log
*.pdb
*.suo
*.user
*.bak
*.ncb
*.scc
*.vssscc
*.vspscc

# Packages
packages/
# NuGet
*.nupkg
# The 'packages' folder may be necessary for older projects using packages.config.
# Newer projects using PackageReference often don't have this folder.

# Test results
TestResults/
*.trx

# Visual Studio files
.vs/
*.vshost.*
*Designer.cs.log
*.resharper
*.dotSettings
*.testsettings
*.runsettings
*.csproj.user
*.vcxproj.user

# ASP.NET Core
/wwwroot/lib/
/wwwroot/dist/

# Entity Framework migrations
# Uncomment the following if you don't want to track EF migrations
# /Migrations/

# User Secrets
appsettings.Development.json
appsettings.Production.json
# Ensure you are not committing any sensitive configuration files like connection strings!
# Commit only generic configuration files like appsettings.json if it contains safe defaults.
# It's highly recommended to use the Secret Manager for development and secure services for production.

# Docker
# /bin/
# /obj/
# **/*.dockerignore (if not in the root)

# Git LFS
# *.rar
# *.zip
# *.7zip
# *.iso